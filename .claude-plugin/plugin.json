{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "uk-police-crime-mcp-server",
  "version": "0.1.1",
  "description": "Search UK street crime, outcomes, stop and search, and neighbourhood teams (Scotland: BTP only).",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/uk-police-crime-mcp-server",
  "repository": "https://github.com/cyanheads/uk-police-crime-mcp-server",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "typescript",
    "bun",
    "stdio",
    "streamable-http",
    "uk",
    "police",
    "crime",
    "crime-data",
    "data-police-uk",
    "stop-and-search",
    "police-outcomes",
    "neighbourhood-policing",
    "open-data",
    "geospatial"
  ],
  "mcpServers": {
    "uk-police-crime-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@cyanheads/uk-police-crime-mcp-server"
      ],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
